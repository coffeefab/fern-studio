# Copy this file to .env for local dev (never commit .env to git)
# Add each variable in Netlify → Site settings → Environment variables

# --- Booqable ---
BOOQABLE_API_KEY=your_api_key_here
BOOQABLE_COMPANY=byfernstudio

# --- Product Group IDs (get these from https://ferneventrentals.com/api/products) ---
BOOQABLE_FLOWER_WALL_ID=
BOOQABLE_ARCH_ID=
BOOQABLE_FRAME_ID=
BOOQABLE_TABLES_ID=
BOOQABLE_DRAPERY_ID=
